<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D depth / shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#E78A1F" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- 3D depth layer 2 -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>